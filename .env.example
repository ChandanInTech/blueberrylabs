# Root example for local orchestration only.
#
# Each submodule owns its own .env.example and its own runtime .env:
#   backend/.env   (copy from backend/.env.example)
#   frontend/.env.local
#
# This file contains placeholders only and is never loaded by either app.

# ---- backend ----------------------------------------------------------------
DATABASE_URL=postgresql://app:app@localhost:5432/social_resizer
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
DEMO_SESSION_SECRET=replace-with-long-random-secret
STORAGE_DRIVER=filesystem

# Railway Buckets (set STORAGE_DRIVER=s3 and fill these to use them locally)
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=

# ---- frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
